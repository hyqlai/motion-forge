    ],
    "avoid": [
      "平级无先后顺序的事物（应改用 gallery-wall-dolly）",
      "时间点超过 5 个"
    ],
    "pairsWith": [
      "component/step-timeline"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      25,
      120,
      260
    ]
  },
  "migration": {
    "source": "video-talkcraft/timeline-photo-strip",
    "sourcePath": "video-talkcraft/template/cards/timeline-photo-strip.tsx",
    "reference": "video-talkcraft/references/cards/timeline-photo-strip.md",
    "status": "ready"
  }
}
