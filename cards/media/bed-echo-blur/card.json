    "image"
  ],
  "aspects": [
    "16:9"
  ],
  "energy": "low",
  "renderers": [
    "html"
  ],
  "timing": {
    "defaultInFrames": 243,
    "minimumInFrames": 90,
    "stretchableHold": true,
