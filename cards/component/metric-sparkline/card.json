      "多指标并列（用 bar-chart-growth 或 chart-grow）",
      "没有趋势数据的孤立数字（用 number-counter）"
    ],
    "pairsWith": [
      "component/number-counter",
      "component/bar-chart-growth"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      0,
      30,
      60
    ]
  },
  "migration": {
    "source": "video-talkcraft/metric-with-sparkline",
    "sourcePath": "video-talkcraft/template/cards/metric-with-sparkline.tsx",
