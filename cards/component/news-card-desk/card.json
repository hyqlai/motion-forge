{
  "id": "component/news-card-desk",
  "version": "1.0.0",
  "kind": "component",
  "title": "新闻报道卡桌面放置",
  "summary": "权威新闻报道卡在桌面以 3D 微俯角切入摆放，标题与引言层次分明，随后荧光笔扫过核心定性短语",
  "intents": [
    "新闻引用",
    "权威背书",
    "舆论举证",
    "客观报道"
  ],
  "genres": [
    "story",
    "explainer",
    "launch",
    "promo"
  ],
  "inputs": [
    "component",
    "text"
  ],
  "aspects": [
    "any"
  ],
  "energy": "low",
  "renderers": [
    "html"
  ],
  "timing": {
    "defaultInFrames": 321,
    "minimumInFrames": 120,
    "stretchableHold": true,
    "params": [
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 321,
        "min": 120,
        "max": 600,
        "step": 15,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "口播引用新闻报道、官方通告作为事实依据",
      "财经、时事、盘点类解说的先看这条新闻时刻"
    ],
    "avoid": [
      "用于极其轻松搞笑的娱乐段落",
      "新闻正文文字过多没有提炼"
    ],
    "pairsWith": [
      "text/highlighter-sweep"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      25,
      110,
      260
    ]
  },
  "migration": {
    "source": "video-talkcraft/news-card-desk",
    "sourcePath": "video-talkcraft/template/cards/news-card-desk.tsx",
    "reference": "video-talkcraft/references/cards/news-card-desk.md",
    "status": "ready"
  }
}
