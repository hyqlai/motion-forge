{
  "id": "component/unit-grid-proportion",
  "version": "1.0.0",
  "kind": "component",
  "title": "点阵比例图",
  "summary": "100 个小方格从中心分环生长，按阅读顺序逐格染成强调色，右侧大数字同步计数，把百分比具象化为可数的点阵个体",
  "intents": [
    "比例说明",
    "转化率",
    "百分比",
    "人群透视"
  ],
  "genres": [
    "story",
    "explainer",
    "launch",
    "promo"
  ],
  "inputs": [
    "component",
    "data"
  ],
  "aspects": [
    "any"
  ],
  "energy": "medium",
  "renderers": [
    "html"
  ],
  "timing": {
    "defaultInFrames": 195,
    "minimumInFrames": 90,
    "stretchableHold": true,
    "params": [
      {
        "name": "target",
        "label": "目标百分比",
        "unit": "frames",
        "defaultValue": 37,
        "min": 5,
        "max": 95,
        "step": 1,
        "description": "染色的方格数量 (0~100)"
      },
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 195,
        "min": 90,
        "max": 360,
        "step": 10,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "口播抛出比例型结论（每 100 个人里有 N 个、留存率/转化率）",
      "社会统计、调研数据可视化"
    ],
    "avoid": [
      "比例超过 80%（建议换成反向未达成比例）",
      "数字计数与方格染色不同步"
    ],
    "pairsWith": [
      "component/number-counter"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      20,
      70,
      140
    ]
  },
  "migration": {
    "source": "video-talkcraft/unit-grid-proportion",
    "sourcePath": "video-talkcraft/template/cards/unit-grid-proportion.tsx",
    "reference": "video-talkcraft/references/cards/unit-grid-proportion.md",
    "status": "ready"
  }
}
