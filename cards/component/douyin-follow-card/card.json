    "pairsWith": [
      "component/lower-third"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      20,
      55,
      110
    ]
  },
  "migration": {
    "source": "video-talkcraft/douyin-follow-card",
    "sourcePath": "video-talkcraft/template/cards/douyin-follow-card.tsx",
