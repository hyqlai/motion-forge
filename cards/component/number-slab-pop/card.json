      "数字超过6位"
    ],
    "pairsWith": [
      "text/keyword-reveal"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      15,
      35,
      75
    ]
  },
  "migration": {
    "source": "video-talkcraft/number-slab-pop",
    "sourcePath": "video-talkcraft/template/cards/number-slab-pop.tsx",
    "reference": "video-talkcraft/references/cards/number-slab-pop.md",
    "status": "ready"
  }
