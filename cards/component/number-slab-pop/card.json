{
  "id": "component/number-slab-pop",
  "version": "1.0.0",
  "kind": "component",
  "title": "数字石碑弹出",
  "summary": "深色石碑卡从下方弹入立住，大号定论数字带重音变色，双层副句相继升起，结尾微收束",
  "intents": [
    "关键结论",
    "定锤数字",
    "封面数",
    "单点论断"
  ],
  "genres": [
    "story",
    "explainer",
    "launch",
    "promo"
  ],
  "inputs": [
    "component",
    "text"
  ],
  "aspects": [
    "any"
  ],
  "energy": "high",
  "renderers": [
    "html"
  ],
  "timing": {
    "defaultInFrames": 101,
    "minimumInFrames": 60,
    "stretchableHold": true,
    "params": [
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 101,
        "min": 60,
        "max": 300,
        "step": 10,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
