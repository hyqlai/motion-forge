{
  "id": "component/terminal-typing-log",
  "version": "1.0.0",
  "kind": "component",
  "title": "终端逐行推进",
  "summary": "包含命令行逐字符敲入、构建日志分块突进、省略号自动冻结悬停与视口整跳零插值滚动",
  "intents": [
    "开发工具",
    "部署日志",
    "技术测评",
    "代码运行举证"
  ],
  "genres": [
    "story",
    "explainer",
    "launch",
    "promo"
  ],
  "inputs": [
    "component",
    "text"
  ],
  "aspects": [
    "any"
  ],
  "energy": "medium",
  "renderers": [
    "html"
  ],
  "timing": {
    "defaultInFrames": 280,
    "minimumInFrames": 120,
    "stretchableHold": true,
    "params": [
      {
        "name": "logRate",
        "label": "日志速率",
        "unit": "frames",
        "defaultValue": 68,
        "min": 30,
        "max": 150,
        "step": 5,
        "description": "日志每秒涌出字符数"
      },
      {
        "name": "cmdRate",
        "label": "命令敲入速率",
        "unit": "frames",
        "defaultValue": 23,
        "min": 10,
        "max": 50,
        "step": 2,
        "description": "模拟键盘打字每秒字符数"
      },
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 280,
        "min": 120,
        "max": 600,
        "step": 15,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "口播念到命令行跑构建、安装依赖或部署上线的时刻",
      "开发者产品展示真跑起来的证据"
    ],
    "avoid": [
      "非技术科普受众的大段终端排版",
      "滚动采用平滑滑行插值（破坏终端整跳硬朗质感）"
    ],
    "pairsWith": [
      "camera/slow-push"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      20,
      100,
      240
    ]
  },
  "migration": {
    "source": "video-talkcraft/terminal-typing-log",
    "sourcePath": "video-talkcraft/template/cards/terminal-typing-log.tsx",
    "reference": "video-talkcraft/references/cards/terminal-typing-log.md",
    "status": "ready"
  }
}
