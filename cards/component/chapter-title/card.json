    ],
    "pairsWith": [
      "transition/pullback-cool",
      "text/keyword-reveal"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      20,
      60,
      150
    ]
  },
  "migration": {
    "source": "video-talkcraft/chapter-title-card",
    "sourcePath": "video-talkcraft/template/cards/chapter-title-card.tsx",
    "reference": "video-talkcraft/references/cards/chapter-title-card.md",
    "status": "ready"
  }
