{
  "id": "component/line-chart-story-draw",
  "version": "1.0.0",
  "kind": "component",
  "title": "折线分段推演",
  "summary": "历史线静置，拐点标注弹出后主推演实线逐段生长，同拐点岔出对比虚线，带区间半透明色带罩显",
  "intents": [
    "假设推演",
    "趋势对比",
    "策略算账",
    "因果链条"
  ],
  "genres": [
    "story",
    "explainer",
    "philosophy",
    "launch",
    "promo"
  ],
  "inputs": [
    "component",
    "data"
  ],
  "aspects": [
    "any"
  ],
  "energy": "medium",
  "renderers": [
    "html",
    "svg"
  ],
  "timing": {
    "defaultInFrames": 156,
    "minimumInFrames": 90,
    "stretchableHold": true,
    "params": [
      {
        "name": "hold0",
        "label": "历史线静置",
        "unit": "seconds",
        "defaultValue": 0.6,
        "min": 0.2,
        "max": 1.5,
        "step": 0.05,
        "description": "开始推演前的历史趋势静止时长"
      },
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 156,
        "min": 90,
        "max": 360,
        "step": 10,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "口播做如果当时...那么现在的假设推演",
      "财经拆解、政策复盘、投资算账的两种未来对比"
    ],
    "avoid": [
      "所有折线段同时出来失去推演节奏",
      "拐点没有明确标注"
    ],
    "pairsWith": [
      "component/bar-chart-growth"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      15,
      60,
      130
    ]
  },
  "migration": {
    "source": "video-talkcraft/line-chart-story-draw",
    "sourcePath": "video-talkcraft/template/cards/line-chart-story-draw.tsx",
    "reference": "video-talkcraft/references/cards/line-chart-story-draw.md",
    "status": "ready"
  }
}
