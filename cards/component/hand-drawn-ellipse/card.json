{
  "id": "component/hand-drawn-ellipse",
  "version": "1.0.0",
  "kind": "component",
  "title": "手绘圈重点",
  "summary": "恒定线宽的手绘质感椭圆逆时针画出（1.08圈尾巴交叉），画完后被圈重点词才 punch 补震一拍",
  "intents": [
    "重点标注",
    "手绘圈",
    "视觉抓眼",
    "金句重音"
  ],
  "genres": [
    "story",
    "explainer",
    "philosophy",
    "promo"
  ],
  "inputs": [
    "text",
    "component"
  ],
  "aspects": [
    "any"
  ],
  "energy": "low",
  "renderers": [
    "html",
    "svg"
  ],
  "timing": {
    "defaultInFrames": 102,
    "minimumInFrames": 60,
    "stretchableHold": true,
    "params": [
      {
        "name": "startDelay",
        "label": "起手静置",
        "unit": "seconds",
        "defaultValue": 0.42,
        "min": 0,
        "max": 1.5,
        "step": 0.05,
        "description": "画圈前的等待时长"
      },
      {
        "name": "draw",
        "label": "画圈耗时",
        "unit": "seconds",
        "defaultValue": 0.5,
        "min": 0.25,
        "max": 1.2,
        "step": 0.05,
        "description": "手绘椭圆一笔画完的耗时"
      },
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 102,
        "min": 60,
        "max": 300,
        "step": 10,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "口播念到关键定论词，需要模拟手绘标注",
      "观点类短片指认单个短语"
    ],
    "avoid": [
      "圈一整行文字（圈的语义是短语指认，圈整行会破坏比例）",
      "圈和文字同时弹跳"
    ],
    "pairsWith": [
      "text/keyword-reveal"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      0,
      25,
      80
    ]
  },
  "migration": {
    "source": "video-talkcraft/hand-drawn-ellipse",
    "sourcePath": "video-talkcraft/template/cards/hand-drawn-ellipse.tsx",
    "reference": "video-talkcraft/references/cards/hand-drawn-ellipse.md",
    "status": "ready"
  }
}
