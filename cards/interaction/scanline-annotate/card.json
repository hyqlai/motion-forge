{
  "id": "interaction/scanline-annotate",
  "version": "1.0.0",
  "kind": "interaction",
  "title": "扫描线逐项点评",
  "summary": "水平扫描线自上而下匀速扫过截图，每经过一个目标框便触发高光锚定与右侧点评标签，AI 解析感强烈",
  "intents": [
    "AI分析",
    "逐条点评",
    "扫描检查",
    "界面审查"
  ],
  "genres": [
    "story",
    "explainer",
    "launch",
    "promo"
  ],
  "inputs": [
    "component",
    "image"
  ],
  "aspects": [
    "any"
  ],
  "energy": "medium",
  "renderers": [
    "html"
  ],
  "timing": {
    "defaultInFrames": 180,
    "minimumInFrames": 90,
    "stretchableHold": true,
    "params": [
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 180,
        "min": 90,
        "max": 360,
        "step": 10,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "口播提到一张截图上有 3~4 处要逐个点评（设计缺陷、合同条款、核心卖点）",
      "AI 帮我读了这份文档的过程镜头"
    ],
    "avoid": [
      "扫描线速度忽快忽慢",
      "目标框超过 5 个"
    ],
    "pairsWith": [
      "camera/slow-push"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      20,
      75,
      140
    ]
  },
  "migration": {
    "source": "video-talkcraft/scanline-annotate",
    "sourcePath": "video-talkcraft/template/cards/scanline-annotate.tsx",
    "reference": "video-talkcraft/references/cards/scanline-annotate.md",
    "status": "ready"
  }
}
