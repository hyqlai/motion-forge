{
  "id": "interaction/chat-message-flow",
  "version": "1.0.0",
  "kind": "interaction",
  "title": "聊天记录自演",
  "summary": "由消息文本长度自动排定时刻表：我方逐字打出后发送弹入，对方经正在输入三点气泡后弹出，延迟贴上表情反馈",
  "intents": [
    "聊天举证",
    "对话演示",
    "客户原声",
    "AI 交互"
  ],
  "genres": [
    "story",
    "explainer",
    "launch",
    "promo"
  ],
  "inputs": [
    "component",
    "text"
  ],
  "aspects": [
    "any"
  ],
  "energy": "medium",
  "renderers": [
    "html"
  ],
  "timing": {
    "defaultInFrames": 198,
    "minimumInFrames": 90,
    "stretchableHold": true,
    "params": [
      {
        "name": "charDur",
        "label": "打字速率",
        "unit": "seconds",
        "defaultValue": 0.12,
        "min": 0.05,
        "max": 0.3,
        "step": 0.01,
        "description": "我方输入框每字打字耗时"
      },
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 198,
        "min": 90,
        "max": 450,
        "step": 15,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "口播甩聊天记录当证据（客户反馈、内部讨论、问答演示）",
      "产品复盘、AI 对话测评"
    ],
    "avoid": [
      "单屏放超过4条长消息",
      "三条消息同时弹入破坏对话真实感"
    ],
    "pairsWith": [
      "text/keyword-reveal"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      20,
      95,
      175
    ]
  },
  "migration": {
    "source": "video-talkcraft/chat-message-flow",
    "sourcePath": "video-talkcraft/template/cards/chat-message-flow.tsx",
    "reference": "video-talkcraft/references/cards/chat-message-flow.md",
    "status": "ready"
  }
}
