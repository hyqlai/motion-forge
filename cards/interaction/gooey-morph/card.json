{
  "id": "interaction/gooey-morph",
  "version": "1.1.0",
  "kind": "interaction",
  "title": "液态路径形变展开",
  "summary": "同一闭合 SVG 路径从圆角母体逐帧插值为多瓣曲线，配合 feColorMatrix 粘连滤镜分裂出多张并列卡片",
  "intents": [
    "证据裂变",
    "多项并列",
    "平台矩阵",
    "有机展开"
  ],
  "genres": [
    "story",
    "explainer",
    "launch",
    "promo"
  ],
  "inputs": [
    "component",
    "image"
  ],
  "aspects": [
    "any"
  ],
  "energy": "medium",
  "renderers": [
    "html",
    "svg"
  ],
  "timing": {
    "defaultInFrames": 97,
    "minimumInFrames": 45,
    "stretchableHold": true,
    "params": [
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 97,
        "min": 45,
        "max": 240,
        "step": 5,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "一次性把 3~4 张并列证据摆上来的时刻（多个平台、多张对比图）",
      "需要它们是一组而不是一张一张讲的整体语义"
    ],
    "avoid": [
      "卡片数超过 5 张导致粘连滤镜边缘粘合重叠穿帮",
      "卡片内包含极高频小文字"
    ],
    "pairsWith": [
      "component/card-fan"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      15,
      35,
      75
    ]
  },
  "migration": {
    "source": "video-talkcraft/gooey-morph",
    "sourcePath": "video-talkcraft/template/cards/gooey-morph.tsx",
    "reference": "video-talkcraft/references/cards/gooey-morph.md",
    "status": "ready"
  }
}
