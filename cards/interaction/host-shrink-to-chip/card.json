{
  "id": "interaction/host-shrink-to-chip",
  "version": "1.0.0",
  "kind": "interaction",
  "title": "主持缩小成角标芯片",
  "summary": "全景出镜人物/主体由画心平滑缩小并滑向左下角定居为角标芯片，让出大屏给主数据或演示截图",
  "intents": [
    "人切图",
    "主角退让",
    "角标化",
    "画中画交接"
  ],
  "genres": [
    "story",
    "explainer",
    "launch",
    "promo"
  ],
  "inputs": [
    "component",
    "video"
  ],
  "aspects": [
    "any"
  ],
  "energy": "low",
  "renderers": [
    "html"
  ],
  "timing": {
    "defaultInFrames": 114,
    "minimumInFrames": 60,
    "stretchableHold": true,
    "params": [
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 114,
        "min": 60,
        "max": 300,
        "step": 10,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "口播从我说给你听切到我给你看图/数据的交接时刻",
      "反复在人与素材之间来回的长视频"
    ],
    "avoid": [
      "缩小时两轴不同步造成人物被压扁",
      "缩小后角标位置遮挡主图关键信息"
    ],
    "pairsWith": [
      "camera/slow-push"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      15,
      45,
      95
    ]
  },
  "migration": {
    "source": "video-talkcraft/host-shrink-to-chip",
    "sourcePath": "video-talkcraft/template/cards/host-shrink-to-chip.tsx",
    "reference": "video-talkcraft/references/cards/host-shrink-to-chip.md",
    "status": "ready"
  }
}
