{
  "id": "interaction/glass-code-walk",
  "version": "1.0.0",
  "kind": "interaction",
  "title": "毛玻璃代码走读",
  "summary": "浮点行号驱动相机与高亮带平滑滑动走读，停顿读完后拉回全景解除压暗",
  "intents": [
    "代码讲解",
    "开源解析",
    "关键实现",
    "逻辑走读"
  ],
  "genres": [
    "story",
    "explainer",
    "launch",
    "promo"
  ],
  "inputs": [
    "component",
    "text"
  ],
  "aspects": [
    "any"
  ],
  "energy": "low",
  "renderers": [
    "html"
  ],
  "timing": {
    "defaultInFrames": 259,
    "minimumInFrames": 120,
    "stretchableHold": true,
    "params": [
      {
        "name": "zoom",
        "label": "走读放大焦距",
        "unit": "frames",
        "defaultValue": 1.68,
        "min": 1.2,
        "max": 2.4,
        "step": 0.05,
        "description": "代码走读特写放大倍数"
      },
      {
        "name": "dwell",
        "label": "单行停留",
        "unit": "seconds",
        "defaultValue": 0.32,
        "min": 0.15,
        "max": 1,
        "step": 0.05,
        "description": "阅读单行代码的停顿时间"
      },
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 259,
        "min": 120,
        "max": 600,
        "step": 15,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "口播带观众读 6~10 行真实核心代码或配置文件",
      "技术教程、踩坑复盘的关键步骤"
    ],
    "avoid": [
      "单屏代码超过 20 行",
      "不拉回全景导致观众丧失整体结构"
    ],
    "pairsWith": [
      "camera/slow-push"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      20,
      90,
      220
    ]
  },
  "migration": {
    "source": "video-talkcraft/glass-code-walk",
    "sourcePath": "video-talkcraft/template/cards/glass-code-walk.tsx",
    "reference": "video-talkcraft/references/cards/glass-code-walk.md",
    "status": "ready"
  }
}
