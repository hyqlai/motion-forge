{
  "id": "environment/canvas-particles",
  "version": "1.0.0",
  "kind": "environment",
  "title": "确定性粒子场",
  "summary": "Canvas 绘制由音乐节拍或情绪驱动的粒子环境",
  "intents": ["氛围", "高潮", "转折"],
  "genres": ["music-visual", "music-story", "story", "launch"],
  "inputs": ["music", "text", "none"],
  "aspects": ["any"],
  "energy": "high",
  "renderers": ["canvas"],
  "timing": {"defaultInFrames": 120, "minimumInFrames": 30, "stretchableHold": true},
  "usage": {
    "when": ["纯音乐需要抽象视觉主体", "故事高潮需要环境能量而非更多信息"],
    "avoid": ["数据解释和密集阅读", "需要完全静止的刻意留白"],
    "pairsWith": ["text/keyword-reveal"],
    "conflictsWith": []
  },
  "qa": {"frames": [0, 45, 100]}
}
