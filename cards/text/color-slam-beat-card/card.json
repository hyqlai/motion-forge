{
  "id": "text/color-slam-beat-card",
  "version": "1.0.0",
  "kind": "text",
  "title": "纯色硬切节拍卡",
  "summary": "硬切纯色底充当节拍器，大字从显影淡色变实，小字副题延迟跟进，下方素材卡升入，最后整组上移让位",
  "intents": [
    "节拍重音",
    "短句立题",
    "高能量切片",
    "论断宣告"
  ],
  "genres": [
    "story",
    "explainer",
    "launch",
    "promo"
  ],
  "inputs": [
    "text",
    "component"
  ],
  "aspects": [
    "any"
  ],
  "energy": "high",
  "renderers": [
    "html"
  ],
  "timing": {
    "defaultInFrames": 215,
    "minimumInFrames": 90,
    "stretchableHold": true,
    "params": [
      {
        "name": "developDur",
        "label": "大字显影时长",
        "unit": "seconds",
        "defaultValue": 0.22,
        "min": 0.1,
        "max": 0.6,
        "step": 0.02,
        "description": "大字从同色系淡色过渡到纯白的显影时长"
      },
      {
        "name": "hold",
        "label": "停留时长",
        "unit": "seconds",
        "defaultValue": 1.6,
        "min": 0.8,
        "max": 4,
        "step": 0.1,
        "description": "内容展示定格时长"
      },
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 215,
        "min": 90,
        "max": 450,
        "step": 15,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "短口播或高潮段抛出鲜明论断（每句话一个高能纯色重音）",
      "全片最抓眼、最吃节拍的章节重锤"
    ],
    "avoid": [
      "连续滥用超过3次造成视觉疲劳",
      "大字与素材卡同时弹出破坏错峰"
    ],
    "pairsWith": [
      "transition/black-slam"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      35,
      75,
      175
    ]
  },
  "migration": {
    "source": "video-talkcraft/color-slam-beat-card",
    "sourcePath": "video-talkcraft/template/cards/color-slam-beat-card.tsx",
    "reference": "video-talkcraft/references/cards/color-slam-beat-card.md",
    "status": "ready"
  }
}
