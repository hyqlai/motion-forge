    "story",
    "explainer",
    "philosophy",
    "launch",
    "promo"
  ],
  "inputs": [
    "text"
  ],
  "aspects": [
    "any"
  ],
  "energy": "low",
  "renderers": [
    "html"
  ],
  "timing": {
    "defaultInFrames": 119,
    "minimumInFrames": 60,
    "stretchableHold": true,
    "params": [
      {
        "name": "lead",
        "label": "起手静置",
        "unit": "seconds",
        "defaultValue": 0.35,
        "min": 0.1,
        "max": 1.2,
        "step": 0.05,
        "description": "引号推入前的静止秒数"
      },
      {
        "name": "markDur",
        "label": "引号推入",
        "unit": "seconds",
        "defaultValue": 0.32,
        "min": 0.15,
        "max": 0.8,
        "step": 0.02,
        "description": "两枚引号向内夹入时长"
