      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 119,
        "min": 60,
        "max": 300,
        "step": 10,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "金句要被引用的时刻（引用他人名言、复述关键主张）",
      "不想盖住背景素材的金句"
    ],
    "avoid": [
      "行数超过4行",
      "引号颜色与正文完全一样（引号应是辅助符号而不是主角）"
    ],
    "pairsWith": [
      "camera/slow-push"
    ],
    "conflictsWith": []
