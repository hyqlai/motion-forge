      "两幕之间风格割裂过于突兀"
    ],
    "pairsWith": [
      "camera/slow-push"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      20,
      80,
      160
    ]
  },
  "migration": {
    "source": "video-talkcraft/long-take-world",
    "sourcePath": "video-talkcraft/template/cards/long-take-world.tsx",
    "reference": "video-talkcraft/references/cards/long-take-world.md",
    "status": "ready"
  }
