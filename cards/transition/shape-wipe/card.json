{
  "id": "transition/shape-wipe",
  "version": "1.0.0",
  "kind": "transition",
  "title": "色块斜切扫屏转场",
  "summary": "三层同色系色块斜切（skewX -12°）错峰高速扫屏，换内容藏在第二层完全遮挡全屏的瞬间",
  "intents": [
    "章节切换",
    "快节奏",
    "观点转折",
    "爆点转场"
  ],
  "genres": [
    "story",
    "explainer",
    "promo",
    "launch"
  ],
  "inputs": [
    "component",
    "image",
    "video"
  ],
  "aspects": [
    "any"
  ],
  "energy": "high",
  "renderers": [
    "html"
  ],
  "timing": {
    "defaultInFrames": 74,
    "minimumInFrames": 35,
    "stretchableHold": true,
    "params": [
      {
        "name": "holdA",
        "label": "前镜停留",
        "unit": "seconds",
        "defaultValue": 0.9,
        "min": 0.2,
        "max": 2,
        "step": 0.05,
        "description": "扫屏启动前的静止时长"
      },
      {
        "name": "wipeDur",
        "label": "单层扫屏",
        "unit": "seconds",
        "defaultValue": 0.45,
        "min": 0.2,
        "max": 1,
        "step": 0.05,
        "description": "单层色块高速划过全屏时长"
      },
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 74,
        "min": 35,
        "max": 180,
        "step": 5,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "快节奏、高能量段落的换章换话题",
      "综艺化或科技发布片的高潮切点"
    ],
    "avoid": [
      "过于沉重缓慢的文艺纪录短片",
      "层间延迟过大导致中途露缝穿帮"
    ],
    "pairsWith": [
      "component/chapter-title"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      15,
      36,
      60
    ]
  },
  "migration": {
    "source": "video-talkcraft/shape-wipe-transition",
    "sourcePath": "video-talkcraft/template/cards/shape-wipe-transition.tsx",
    "reference": "video-talkcraft/references/cards/shape-wipe-transition.md",
    "status": "ready"
  }
}
