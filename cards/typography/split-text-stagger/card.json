{
  "id": "typography/split-text-stagger",
  "version": "1.0.0",
  "kind": "typography",
  "title": "文字裁切错峰生长",
  "summary": "文字从隐形基线下缘带 clip-path 裁切错峰升起，底部一条精细下划线自中心横向展开垫底",
  "intents": [
    "章节题字",
    "片名字卡",
    "要点逐条上台",
    "利落入场"
  ],
  "genres": [
    "story",
    "explainer",
    "philosophy",
    "launch",
    "promo"
  ],
  "inputs": [
    "text"
  ],
  "aspects": [
    "any"
  ],
  "energy": "medium",
  "renderers": [
    "html"
  ],
  "timing": {
    "defaultInFrames": 156,
    "minimumInFrames": 60,
    "stretchableHold": true,
    "params": [
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 156,
        "min": 60,
        "max": 300,
        "step": 10,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "章节题字、频道名字卡、有版式要求的要点上台",
      "需要文字被基线裁着长出来的精细排版"
    ],
    "avoid": [
      "文字超过 16 个字导致单字过小",
      "没有基线裁切直接普通淡入"
    ],
    "pairsWith": [
      "text/char-rise"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      15,
      45,
      110
    ]
  },
  "migration": {
    "source": "video-talkcraft/split-text-stagger",
    "sourcePath": "video-talkcraft/template/cards/split-text-stagger.tsx",
    "reference": "video-talkcraft/references/cards/split-text-stagger.md",
    "status": "ready"
  }
}
