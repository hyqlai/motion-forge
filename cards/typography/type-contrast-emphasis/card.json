{
  "id": "typography/type-contrast-emphasis",
  "version": "1.0.0",
  "kind": "typography",
  "title": "黑白反色对比强调",
  "summary": "前半句白字常亮，后半句通过实心深黑底块与高亮反转形成重音判断，冷静克制无综艺弹跳",
  "intents": [
    "判断句",
    "反转词",
    "结论对比",
    "克制重音"
  ],
  "genres": [
    "story",
    "explainer",
    "philosophy",
    "launch",
    "promo"
  ],
  "inputs": [
    "text"
  ],
  "aspects": [
    "any"
  ],
  "energy": "low",
  "renderers": [
    "html"
  ],
  "timing": {
    "defaultInFrames": 67,
    "minimumInFrames": 35,
    "stretchableHold": true,
    "params": [
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 67,
        "min": 35,
        "max": 180,
        "step": 5,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "口播的判断句/反转句/结论词（尤其不是 A，是 B 句式）",
      "想要重音但不要综艺弹跳的个人观点短片"
    ],
    "avoid": [
      "整段跟读字幕每句都用",
      "反色块两边边距不对称"
    ],
    "pairsWith": [
      "text/strike-replace"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      10,
      25,
      55
    ]
  },
  "migration": {
    "source": "video-talkcraft/type-contrast-emphasis",
    "sourcePath": "video-talkcraft/template/cards/type-contrast-emphasis.tsx",
    "reference": "video-talkcraft/references/cards/type-contrast-emphasis.md",
    "status": "ready"
  }
}
