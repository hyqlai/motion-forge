{
  "id": "typography/countdown-arc-scatter",
  "version": "1.0.0",
  "kind": "typography",
  "title": "数字弧落标题",
  "summary": "一串相邻递减数字排在圆弧上急停扫过，选中数停在弧顶后平移回正为标题首字，其余数字原地失焦散去",
  "intents": [
    "数字承诺",
    "悬念揭晓",
    "时长承诺",
    "仪表盘标题"
  ],
  "genres": [
    "story",
    "explainer",
    "launch",
    "promo"
  ],
  "inputs": [
    "text"
  ],
  "aspects": [
    "any"
  ],
  "energy": "high",
  "renderers": [
    "html",
    "svg"
  ],
  "timing": {
    "defaultInFrames": 162,
    "minimumInFrames": 90,
    "stretchableHold": true,
    "params": [
      {
        "name": "sweep",
        "label": "扫动急停时长",
        "unit": "seconds",
        "defaultValue": 0.57,
        "min": 0.3,
        "max": 1.2,
        "step": 0.05,
        "description": "圆盘96度扫到0度的减速急停时长"
      },
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 162,
        "min": 90,
        "max": 360,
        "step": 10,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "数字本身是悬念的标题（5 分钟搭好系统、3 个原则）",
      "需要仪表盘精密语汇的短镜"
    ],
    "avoid": [
      "落位后留过长空白断成两个动作",
      "其余数字位移与落位抢戏"
    ],
    "pairsWith": [
      "text/keyword-reveal"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      20,
      45,
      120
    ]
  },
  "migration": {
    "source": "video-talkcraft/countdown-arc-scatter",
    "sourcePath": "video-talkcraft/template/cards/countdown-arc-scatter.tsx",
    "reference": "video-talkcraft/references/cards/countdown-arc-scatter.md",
    "status": "ready"
  }
