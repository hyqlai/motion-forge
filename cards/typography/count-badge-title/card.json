{
  "id": "typography/count-badge-title",
  "version": "1.0.0",
  "kind": "typography",
  "title": "数字重音标题",
  "summary": "大号数字先到并变色，随后带出量词后缀与第二行说明，结尾带一次极轻微的重音补拍",
  "intents": [
    "条数承诺",
    "方法论",
    "钩子",
    "章节引出"
  ],
  "genres": [
    "story",
    "explainer",
    "promo"
  ],
  "inputs": [
    "text"
  ],
  "aspects": [
    "any"
  ],
  "energy": "medium",
  "renderers": [
    "html"
  ],
  "timing": {
    "defaultInFrames": 112,
    "minimumInFrames": 60,
    "stretchableHold": true,
    "params": [
      {
        "name": "startDelay",
        "label": "起手静置",
        "unit": "seconds",
        "defaultValue": 0.4,
        "min": 0,
        "max": 1.5,
        "step": 0.05,
        "description": "数字入场前的等待秒数"
      },
      {
        "name": "numIn",
        "label": "数字耗时",
        "unit": "seconds",
        "defaultValue": 0.3,
        "min": 0.15,
        "max": 0.8,
        "step": 0.02,
        "description": "大号数字从 1.6 倍缩到位入场时长"
      },
      {
        "name": "totalFrames",
        "label": "总时长 (帧)",
        "unit": "frames",
        "defaultValue": 112,
        "min": 60,
        "max": 300,
        "step": 10,
        "description": "全卡总帧数"
      }
    ]
  },
  "usage": {
    "when": [
      "口播开场承诺条数（三个方法/五个坑）",
      "列表卡之前的一屏重音"
    ],
    "avoid": [
      "数字超过两位数",
      "三段同时淡入破坏先后节奏"
    ],
    "pairsWith": [
      "component/step-stack"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      0,
      25,
      90
    ]
  },
  "migration": {
    "source": "video-talkcraft/count-badge-title",
    "sourcePath": "video-talkcraft/template/cards/count-badge-title.tsx",
    "reference": "video-talkcraft/references/cards/count-badge-title.md",
    "status": "ready"
  }
