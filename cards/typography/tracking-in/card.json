    "pairsWith": [
      "camera/slow-push"
    ],
    "conflictsWith": []
  },
  "qa": {
    "frames": [
      15,
      35,
      75
    ]
  },
  "migration": {
    "source": "video-talkcraft/tracking-in",
    "sourcePath": "video-talkcraft/template/cards/tracking-in.tsx",
    "reference": "video-talkcraft/references/cards/tracking-in.md",
    "status": "ready"
  }
