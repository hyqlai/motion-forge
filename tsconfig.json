{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "core/**/*.ts",
    "core/**/*.tsx",
    "cards/**/*.ts",
    "cards/**/*.tsx",
    "scenes/**/*.ts",
    "scenes/**/*.tsx",
    "providers/**/*.ts",
    "scripts/**/*.ts",
    "workbench/**/*.ts",
    "workbench/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx"
  ]
}
